{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Lesson generation streams for minutes; don't cut long responses.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
		transport http {
			read_timeout 15m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
