# OpenMAIC app config. Copy to openmaic.env (gitignored); bootstrap.sh installs it as upstream/.env.local.
# Full variable reference: https://github.com/THU-MAIC/OpenMAIC/blob/main/.env.example

# --- Access control (REQUIRED: without it anyone can use the site on your credit) ---
# Generate: openssl rand -base64 18
ACCESS_CODE=

# --- LLM: OpenRouter (https://openrouter.ai/keys) — set a credit limit on the key ---
OPENROUTER_API_KEY=
# Allow-list of models users can pick (OpenRouter model IDs, comma-separated).
# Keep it short: every entry is a model someone can run on your bill.
OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,google/gemini-2.5-flash

# --- Optional: images via OpenRouter ---
# IMAGE_OPENROUTER_API_KEY=
# IMAGE_OPENROUTER_MODELS=

# --- Optional: web search for lesson research (https://tavily.com) ---
# TAVILY_API_KEY=

# --- Optional: speech. OpenRouter does not do TTS/ASR; browser-native voice works with no key. ---
# TTS_OPENAI_API_KEY=
# ASR_OPENAI_API_KEY=

# --- Deployment hardening ---
# We sit behind Caddy (HTTPS), so trust its forwarding headers and keep cookies Secure.
TRUST_PROXY_HEADERS=true
# Upstream's compose defaults to OWNER_SINGLE_USER=true: everyone who knows the access code shares
# one course library. Set OWNER_SINGLE_USER=false for a private workspace per browser instead.
LOG_FORMAT=json
