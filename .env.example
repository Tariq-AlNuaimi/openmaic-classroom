# Deploy-level settings. Copy to .env (gitignored) and fill in.

# Upstream release to run (https://github.com/THU-MAIC/OpenMAIC/releases). Stable only, no -rc.
OPENMAIC_VERSION=v1.2.1

# Public hostname pointing at this VM (A record). Caddy gets a Let's Encrypt cert for it.
DOMAIN=classroom.example.com

# Bundled Postgres password, letters+digits only. Generate: openssl rand -hex 24
# Set BEFORE the first start: it only initialises an empty volume.
PERSISTENCE_POSTGRES_PASSWORD=""
